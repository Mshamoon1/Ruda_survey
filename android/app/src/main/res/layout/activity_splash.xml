<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_splash_gradient">

    <!-- Top decorative arc -->
    <View
        android:id="@+id/topArc"
        android:layout_width="0dp"
        android:layout_height="200dp"
        android:background="@drawable/bg_splash_top_arc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main content centered -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo -->
        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/logo"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="24dp" />

        <!-- App Name -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_title"
            android:textSize="36sp"
            android:fontFamily="@font/inter_semibold"
            android:textColor="@android:color/white"
            android:letterSpacing="0.15"
            android:layout_marginBottom="4dp" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_subtitle"
            android:textSize="14sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#B3FFFFFF"
            android:letterSpacing="0.05" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvOrgName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/splash_org_name"
            android:textSize="11sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#80FFFFFF"
            android:letterSpacing="0.03"
            android:layout_marginTop="8dp" />

    </LinearLayout>

    <!-- Bottom loading indicator -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/progressBar"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminate="true"
            app:indicatorSize="32dp"
            app:trackThickness="3dp"
            app:indicatorColor="@android:color/white"
            app:trackColor="#40FFFFFF"
            android:layout_marginBottom="12dp" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/loading"
            android:textSize="12sp"
            android:fontFamily="@font/inter_regular"
            android:textColor="#B3FFFFFF" />

    </LinearLayout>

    <!-- Version -->
    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_version_display"
        android:textSize="11sp"
        android:fontFamily="@font/inter_regular"
        android:textColor="#80FFFFFF"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
