<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surfaceVariant">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md_toolbar_bg"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="36dp"
        android:paddingBottom="@dimen/spacing_12"
        android:elevation="@dimen/elevation_4">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/my_surveys_title"
            android:textAppearance="@style/TextAppearance.RudaSurvey.TitleLarge"
            android:textColor="@color/md_on_toolbar" />

    </LinearLayout>

    <!-- Survey count header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        android:paddingVertical="@dimen/spacing_12">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvSurveyCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/TextAppearance.RudaSurvey.BodyMedium"
            android:textColor="@color/md_theme_onSurfaceVariant"
            tools:text="3 surveys found" />

    </LinearLayout>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_surveys_24"
            app:tint="@color/md_theme_outline"
            android:contentDescription="@string/desc_no_surveys" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_12"
            android:text="@string/label_no_surveys_yet"
            android:textAppearance="@style/TextAppearance.RudaSurvey.TitleMedium"
            android:textColor="@color/md_theme_onSurfaceVariant" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_4"
            android:text="@string/label_create_survey_hint"
            android:textAppearance="@style/TextAppearance.RudaSurvey.BodySmall"
            android:textColor="@color/md_theme_outline" />

    </LinearLayout>

    <!-- Survey list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSurveys"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_horizontal_margin"
        android:paddingTop="@dimen/spacing_4"
        android:paddingBottom="@dimen/spacing_24"
        android:scrollbars="vertical" />

</LinearLayout>
