<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/screen_horizontal_margin"
    android:layout_marginEnd="@dimen/screen_horizontal_margin"
    android:layout_marginBottom="@dimen/spacing_8"
    app:cardCornerRadius="@dimen/corner_xl"
    app:cardElevation="@dimen/elevation_0"
    app:strokeWidth="1dp"
    app:strokeColor="@color/md_theme_outlineVariant"
    android:foreground="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/card_padding"
        android:gravity="center_vertical">

        <!-- Lead Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="@dimen/corner_medium"
            app:cardBackgroundColor="@color/md_theme_primaryContainer"
            app:cardElevation="0dp"
            android:layout_marginEnd="@dimen/spacing_12">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_landscape"
                android:contentDescription="@string/hint_village"
                app:tint="@color/md_theme_onPrimaryContainer" />

        </com.google.android.material.card.MaterialCardView>

        <!-- Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvParcelCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.RudaSurvey.TitleMedium"
                android:textColor="?attr/colorOnSurface"
                android:ellipsize="end"
                android:maxLines="1" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvKhasra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.RudaSurvey.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="@dimen/spacing_2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvMauza"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.RudaSurvey.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="@dimen/spacing_2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.RudaSurvey.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_marginTop="@dimen/spacing_2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textAppearance="@style/TextAppearance.RudaSurvey.LabelSmall"
                android:textColor="@color/md_theme_outline"
                android:layout_marginTop="@dimen/spacing_4" />

        </LinearLayout>

        <!-- Trailing Arrow -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_forward"
            android:contentDescription="@string/btn_view_edit"
            app:tint="@color/md_theme_outline" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
