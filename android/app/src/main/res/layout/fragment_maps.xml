<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_surface"
    tools:context=".ui.map.MapsFragment">

    <!-- OpenStreetMap -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

    <!-- Toolbar -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="4dp"
        android:background="@android:color/transparent">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="@color/md_theme_onPrimary"
            android:background="@color/md_toolbar_bg"
            app:title="Survey Map"
            app:titleTextColor="@color/md_theme_onPrimary"
            app:subtitleTextColor="@color/md_theme_onPrimary" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Status chip -->
    <com.google.android.material.chip.Chip
        android:id="@+id/chipStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:elevation="6dp"
        android:backgroundTint="@color/md_surface"
        android:textColor="@color/md_theme_onSurface"
        app:chipMinHeight="32dp"
        app:chipCornerRadius="16dp"
        app:chipStrokeWidth="1dp"
        app:chipStrokeColor="@color/md_theme_outlineVariant"
        android:text="0 surveys"
        tools:text="12 surveys" />

    <!-- List toggle FAB -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:elevation="6dp"
        android:text="Surveys"
        android:textColor="@color/md_theme_onPrimary"
        app:icon="@drawable/ic_layers"
        app:iconTint="@color/md_theme_onPrimary"
        app:backgroundTint="@color/md_theme_primary" />

    <!-- My Location FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabMyLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="80dp"
        android:elevation="6dp"
        android:src="@drawable/ic_my_location"
        android:contentDescription="My Location"
        app:backgroundTint="@color/md_theme_secondary"
        app:tint="@color/md_theme_onSecondary" />

    <!-- Survey list bottom sheet -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardList"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_gravity="bottom"
        android:elevation="8dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:strokeWidth="0dp"
        android:visibility="gone"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_peekHeight="0dp"
        app:behavior_skipCollapsed="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:background="@color/md_surface">

            <!-- Handle -->
            <View
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_handle" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Survey Sites"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:paddingHorizontal="20dp"
                android:paddingBottom="4dp" />

            <TextView
                android:id="@+id/tvListSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tap a survey to locate it on map"
                android:textSize="12sp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:paddingHorizontal="20dp"
                android:paddingBottom="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/md_theme_outlineVariant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSurveys"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
