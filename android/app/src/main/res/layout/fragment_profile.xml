<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_surfaceVariant">

    <!-- Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/md_toolbar_bg"
        android:paddingStart="@dimen/screen_horizontal_margin"
        android:paddingEnd="@dimen/spacing_16"
        android:paddingTop="36dp"
        android:paddingBottom="@dimen/spacing_12"
        android:elevation="@dimen/elevation_4">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textAppearance="@style/TextAppearance.RudaSurvey.TitleLarge"
            android:textColor="@color/md_on_toolbar" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_horizontal_margin"
            android:paddingTop="@dimen/spacing_24">

            <!-- Profile avatar card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="@dimen/elevation_1"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:padding="@dimen/spacing_24">

                    <!-- Avatar circle -->
                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_kpi_icon_blue">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_person"
                            android:tint="@android:color/white"
                            android:contentDescription="Profile" />

                    </FrameLayout>

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_12"
                        android:textAppearance="@style/TextAppearance.RudaSurvey.TitleMedium"
                        android:textColor="@color/md_theme_onSurface"
                        tools:text="Surveyor" />

                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvUserRole"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_2"
                        android:textAppearance="@style/TextAppearance.RudaSurvey.BodyMedium"
                        android:textColor="@color/md_theme_onSurfaceVariant"
                        tools:text="Field Surveyor" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Info section -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardCornerRadius="@dimen/corner_large"
                app:cardElevation="@dimen/elevation_1"
                app:strokeWidth="1dp"
                app:strokeColor="@color/md_theme_outlineVariant"
                app:cardBackgroundColor="@color/md_theme_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <!-- Email row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_email"
                            app:tint="@color/md_theme_onSurfaceVariant"
                            android:contentDescription="Email" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/spacing_12">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email"
                                android:textAppearance="@style/TextAppearance.RudaSurvey.LabelMedium"
                                android:textColor="@color/md_theme_onSurfaceVariant" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvUserEmail"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.RudaSurvey.BodyMedium"
                                android:textColor="@color/md_theme_onSurface"
                                tools:text="surveyor@ruda.gov.pk" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_outlineVariant" />

                    <!-- Role row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_security"
                            app:tint="@color/md_theme_onSurfaceVariant"
                            android:contentDescription="Role" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/spacing_12">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Role"
                                android:textAppearance="@style/TextAppearance.RudaSurvey.LabelMedium"
                                android:textColor="@color/md_theme_onSurfaceVariant" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvProfileRole"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.RudaSurvey.BodyMedium"
                                android:textColor="@color/md_theme_onSurface"
                                tools:text="Field Surveyor" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/md_theme_outlineVariant" />

                    <!-- App version row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingVertical="@dimen/spacing_12">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_info"
                            app:tint="@color/md_theme_onSurfaceVariant"
                            android:contentDescription="Version" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/spacing_12">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="App Version"
                                android:textAppearance="@style/TextAppearance.RudaSurvey.LabelMedium"
                                android:textColor="@color/md_theme_onSurfaceVariant" />

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvAppVersion"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textAppearance="@style/TextAppearance.RudaSurvey.BodyMedium"
                                android:textColor="@color/md_theme_onSurface"
                                tools:text="1.0.0" />

                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Logout button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnProfileLogout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_large"
                android:layout_marginTop="@dimen/spacing_24"
                android:text="@string/btn_logout"
                app:icon="@drawable/ic_logout"
                app:iconGravity="textStart"
                app:iconTint="@color/md_theme_error"
                style="@style/Widget.RudaSurvey.Button.Destructive" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
