<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="top"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_16"
    android:paddingTop="@dimen/spacing_4"
    android:paddingEnd="@dimen/spacing_16"
    android:paddingBottom="@dimen/spacing_4">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFieldLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.42"
        android:fontFamily="@font/inter_regular"
        android:gravity="start"
        android:paddingEnd="@dimen/spacing_8"
        android:textAlignment="viewStart"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:textSize="@dimen/text_size_body_small" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvFieldValue"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.58"
        android:ellipsize="end"
        android:fontFamily="@font/inter_medium"
        android:gravity="end"
        android:maxLines="2"
        android:textAlignment="viewEnd"
        android:textColor="@color/md_theme_primary"
        android:textSize="@dimen/text_size_body_small" />

</LinearLayout>
