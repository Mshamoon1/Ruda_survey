<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================ -->
    <!-- TEXT APPEARANCES — Inter Font Family          -->
    <!-- ============================================ -->

    <style name="TextAppearance.RudaSurvey.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>
    </style>

    <style name="TextAppearance.RudaSurvey.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>
    </style>

    <style name="TextAppearance.RudaSurvey.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/md_theme_onBackground</item>
    </style>

    <style name="TextAppearance.RudaSurvey.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.RudaSurvey.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.RudaSurvey.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/inter_semibold</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.RudaSurvey.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.RudaSurvey.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="TextAppearance.RudaSurvey.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/inter_regular</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="TextAppearance.RudaSurvey.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/md_theme_onSurface</item>
    </style>

    <style name="TextAppearance.RudaSurvey.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <style name="TextAppearance.RudaSurvey.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
    </style>

    <!-- ============================================ -->
    <!-- BUTTON STYLES                                -->
    <!-- ============================================ -->

    <style name="Widget.RudaSurvey" parent="Widget.MaterialComponents.Button" />

    <style name="Widget.RudaSurvey.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/md_theme_primary</item>
        <item name="android:textColor">@color/md_theme_onPrimary</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:minHeight">@dimen/button_height_large</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:textSize">@dimen/text_size_body_large</item>
    </style>

    <style name="Widget.RudaSurvey.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/md_theme_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.RudaSurvey.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/md_theme_secondaryContainer</item>
        <item name="android:textColor">@color/md_theme_onSecondaryContainer</item>
        <item name="cornerRadius">@dimen/corner_medium</item>
        <item name="android:minHeight">@dimen/button_height_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.RudaSurvey.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/md_theme_primary</item>
        <item name="android:minHeight">@dimen/button_height_small</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <style name="Widget.RudaSurvey.Button.Icon" parent="Widget.Material3.Button.IconButton">
        <item name="backgroundTint">@color/md_theme_surfaceContainerHigh</item>
        <item name="iconTint">@color/md_theme_onSurface</item>
    </style>

    <!-- ============================================ -->
    <!-- CARD STYLES                                  -->
    <!-- ============================================ -->

    <style name="Widget.RudaSurvey.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_xl</item>
        <item name="cardElevation">@dimen/elevation_0</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="android:layout_marginStart">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginBottom">@dimen/spacing_12</item>
        <item name="cardBackgroundColor">@color/md_theme_surface</item>
    </style>

    <style name="Widget.RudaSurvey.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/corner_xl</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/md_theme_outlineVariant</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="android:layout_marginStart">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginBottom">@dimen/spacing_12</item>
        <item name="cardElevation">@dimen/elevation_0</item>
    </style>

    <style name="Widget.RudaSurvey.Card.Tonal" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/corner_xl</item>
        <item name="cardElevation">@dimen/elevation_0</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">@dimen/card_padding</item>
        <item name="android:layout_marginStart">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginEnd">@dimen/screen_horizontal_margin</item>
        <item name="android:layout_marginBottom">@dimen/spacing_12</item>
        <item name="cardBackgroundColor">@color/md_theme_primaryContainer</item>
    </style>

    <!-- ============================================ -->
    <!-- TEXT INPUT STYLES                            -->
    <!-- ============================================ -->

    <style name="Widget.RudaSurvey.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_medium</item>
        <item name="boxStrokeColor">@color/md_theme_outline</item>
        <item name="hintTextColor">@color/md_theme_primary</item>
        <item name="android:layout_marginBottom">@dimen/field_spacing</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>

    <!-- ============================================ -->
    <!-- CHIP STYLES                                  -->
    <!-- ============================================ -->

    <style name="Widget.RudaSurvey.Chip.Filter" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/corner_full</item>
        <item name="chipBackgroundColor">@color/md_theme_surfaceVariant</item>
        <item name="android:textColor">@color/md_theme_onSurfaceVariant</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:fontFamily">@font/inter_medium</item>
    </style>

    <!-- ============================================ -->
    <!-- SECTION HEADER                               -->
    <!-- ============================================ -->

    <style name="Widget.RudaSurvey.SectionHeader">
        <item name="android:paddingStart">@dimen/screen_horizontal_margin</item>
        <item name="android:paddingEnd">@dimen/screen_horizontal_margin</item>
        <item name="android:paddingTop">@dimen/section_vertical_spacing</item>
        <item name="android:paddingBottom">@dimen/spacing_8</item>
    </style>

</resources>
